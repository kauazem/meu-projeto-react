* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f2f4f7;
}

.app {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 230px;
  background: #111827;
  color: white;
  padding: 25px 15px;
}

.sidebar h2 {
  text-align: center;
  margin-bottom: 35px;
}

.sidebar button {
  display: block;
  width: 100%;
  padding: 14px;
  margin-bottom: 10px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: white;
  text-align: left;
  font-size: 15px;
  cursor: pointer;
}

.sidebar button:hover {
  background: #374151;
}

.content {
  flex: 1;
  padding: 40px;
}

.content h1 {
  font-size: 32px;
  margin-bottom: 8px;
}

.content > p {
  color: #6b7280;
  margin-bottom: 30px;
}

.cards {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 15px;
  width: 250px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

.card h3 {
  margin-bottom: 15px;
}

.card p {
  color: #6b7280;
  margin-bottom: 12px;
}

.card strong {
  font-size: 18px;
}